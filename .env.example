# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш chat_id. Если задан — бот отвечает только этому чату.
# Если пусто — подписаться через /start может любой, кто найдёт бота.
TELEGRAM_CHAT_ID=

# Интервал проверки в минутах (не меньше 2)
CHECK_INTERVAL_MIN=5

# Через запятую, по части названия, без учёта регистра. Пусто = все спектакли.
# Используется только при первом запуске; дальше список меняется командами /watch и /unwatch.
WATCH_TITLES=

# Диапазон дат сеансов, формат ГГГГ-ММ-ДД. Пусто = без ограничения.
DATE_FROM=
DATE_TO=

# true — при первом запуске прислать сводку по всем сеансам
FIRST_RUN_SUMMARY=true

STATE_FILE=state.json
LOG_FILE=bot.log
